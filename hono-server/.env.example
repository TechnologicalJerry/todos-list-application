PORT=3000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_db

# Security & JWT Secrets
JWT_SECRET=super_secret_access_key_change_in_production_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*
