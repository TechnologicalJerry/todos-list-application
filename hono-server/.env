PORT=3000
NODE_ENV=test

DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_db

JWT_SECRET=dev_access_token_secret_key_32_bytes_long!!
JWT_REFRESH_SECRET=dev_refresh_token_secret_key_32_bytes_long!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=*
